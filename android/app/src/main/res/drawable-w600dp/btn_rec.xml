<?xml version="1.0" encoding="utf-8"?>
<!-- Grabando: el mismo círculo, oscuro con anillo lima (el rojo asustaba en la cocina). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="@color/surface3" /><stroke android:width="5dp" android:color="@color/lima" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="@color/bg" /><stroke android:width="5dp" android:color="@color/lima" /></shape></item>
</selector>
