<?xml version="1.0" encoding="utf-8"?>
<!--
  Tablet (≥600dp de ancho), calcada de diseno/propuesta.html: arriba la marca, la vista y la hora; abajo la lista a
  la izquierda (tarjetas por góndola en dos columnas, o una sola columna con "Todo junto") y a la derecha la heladera
  que habla. Los ids compartidos son los del teléfono; los que sólo existen acá MainActivity los trata como opcionales.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingLeft="24dp"
    android:paddingTop="16dp"
    android:paddingRight="24dp"
    android:paddingBottom="20dp">

    <!-- ============ arriba ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginRight="12dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="26dp"
            android:text="Heladera"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/seg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/pill"
            android:padding="4dp">

            <TextView
                android:id="@+id/segGondola"
                style="@style/Seg"
                android:text="Por góndola" />

            <TextView
                android:id="@+id/segTodo"
                style="@style/Seg"
                android:text="Todo junto" />

            <TextView
                android:id="@+id/segListas"
                style="@style/Seg"
                android:text="Por lista" />
        </LinearLayout>

        <TextView
            android:id="@+id/allToggle"
            style="@style/Pastilla"
            android:layout_marginLeft="8dp"
            android:text="Todas"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pickToggle"
            style="@style/Pastilla"
            android:layout_marginLeft="8dp"
            android:text="Elegir" />

        <TextView
            android:id="@+id/superToggle"
            style="@style/Pastilla"
            android:layout_marginLeft="8dp"
            android:drawablePadding="7dp"
            android:text="En el súper" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="12dp" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="right">

            <TextClock
                android:id="@+id/hora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="H:mm"
                android:format24Hour="H:mm"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <TextClock
                android:id="@+id/fecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d"
                android:format24Hour="EEEE d"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ abajo ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- la lista -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginRight="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true"
                android:paddingBottom="14dp">

                <!-- cuánto falta, grande: se lee desde la otra punta de la cocina -->
                <TextView
                    android:id="@+id/count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="50sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:tag="grande" />

                <TextView
                    android:id="@+id/enCarrito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:textColor="@color/muted"
                    android:textSize="17sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/tabsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/listContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- en el súper: volver o terminar -->
            <LinearLayout
                android:id="@+id/barraSuper"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/superVolver"
                    style="@style/Accion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginRight="12dp"
                    android:textSize="17sp"
                    android:text="Volver a la lista" />

                <TextView
                    android:id="@+id/superTerminar"
                    style="@style/Accion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_talk_barra"
                    android:textColor="@color/bg"
                    android:textSize="17sp"
                    android:text="Terminé la compra" />
            </LinearLayout>
        </LinearLayout>

        <!-- la heladera que habla -->
        <LinearLayout
            android:id="@+id/panelCharla"
            android:layout_width="336dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/panel_charla"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/wakeToggle"
                style="@style/Pastilla"
                android:layout_gravity="right"
                android:drawablePadding="7dp"
                android:text="Manos libres" />

            <!-- la charla se apoya abajo, cerca del botón -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/oido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginLeft="24dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/burbuja_yo"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:maxLines="5"
                    android:ellipsize="start"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hecho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/chip_lima"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/lima"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="Tocá Hablar y decime qué falta."
                    android:textColor="@color/text"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="6"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- el botón, con sus anillos (escucha) y su giro (piensa) por detrás -->
            <FrameLayout
                android:layout_width="264dp"
                android:layout_height="264dp"
                android:layout_marginTop="14dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/anillo1"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_gravity="center"
                    android:background="@drawable/anillo"
                    android:alpha="0" />

                <View
                    android:id="@+id/anillo2"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_gravity="center"
                    android:background="@drawable/anillo"
                    android:alpha="0" />

                <ProgressBar
                    android:id="@+id/giro"
                    android:layout_width="264dp"
                    android:layout_height="264dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/lima"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/btnTalk"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_talk"
                    android:gravity="center"
                    android:text="Hablar"
                    android:textColor="@color/bg"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textSize="23sp"
                    android:fontFamily="sans-serif-black" />

                <!-- la cara del botón: ícono u ondas arriba, la palabra abajo (no toma toques: pasan al botón) -->
                <LinearLayout
                    android:id="@+id/cara"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/caraIcono"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/ic_mic_grande" />

                    <ar.tecnomanu.heladera.Ondas
                        android:id="@+id/caraOndas"
                        android:layout_width="54dp"
                        android:layout_height="46dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/caraTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Hablar"
                        android:textColor="@color/bg"
                        android:textSize="24sp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/pista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="o escribí en el menú Más"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/btnQuiet"
                style="@style/Accion"
                android:visibility="gone"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="Escucharme"
                android:textColor="@color/cyan" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSend"
                    style="@style/Accion"
                    android:layout_marginRight="8dp"
                    android:text="Mandar" />

                <TextView
                    android:id="@+id/btnMenu"
                    style="@style/Accion"
                    android:text="Más" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
