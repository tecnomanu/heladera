# Todo es opcional: lo que pongas acá pisa la configuración de ~/.heladera/config.json.
# Sirve para docker y para probar sin tocar el json.

HELADERA_PORT=8790
HELADERA_LANGUAGE=es

# Entender los pedidos
HELADERA_LLM_PROVIDER=ollama          # ollama | openai
HELADERA_LLM_URL=http://127.0.0.1:11434
HELADERA_LLM_MODEL=qwen3:8b
# HELADERA_LLM_KEY=

# Voz a texto
HELADERA_STT_PROVIDER=local           # local | openai | custom
# HELADERA_STT_URL=https://api.openai.com
# HELADERA_STT_MODEL=whisper-1
# HELADERA_STT_KEY=

# Contestar en voz
HELADERA_TTS_PROVIDER=local           # local | openai | device | none
HELADERA_TTS_VOICE=es_AR-daniela-high
# HELADERA_TTS_URL=
# HELADERA_TTS_KEY=

# Mandar la lista
# HELADERA_TELEGRAM_TOKEN=
# HELADERA_TELEGRAM_CHAT_ID=

# Seguridad: si no lo ponés se genera uno solo la primera vez
# HELADERA_TOKEN=
# HELADERA_NO_AUTH=1
